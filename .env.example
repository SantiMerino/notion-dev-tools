# Internal integration token from https://www.notion.so/profile/integrations
# Starts with "ntn_". Server-only — never prefix this with NEXT_PUBLIC_.
NOTION_TOKEN=

# The page whose child pages are your posts (your "web-blog" page).
# Open it in Notion, Copy link, and take the 32-char id from the URL.
NOTION_BLOG_PAGE_ID=

# Any long random string. Guards the manual POST /api/revalidate trigger.
# Generate one with: node -e "console.log(crypto.randomUUID())"
REVALIDATE_SECRET=

# The verification_token Notion returns when you create the webhook
# subscription (see README "Refreshing after an edit"). Used to check the
# HMAC signature on incoming webhook events. Leave blank until you have it.
NOTION_WEBHOOK_SECRET=

# Canonical public URL, used as metadataBase for og:image / canonical links.
# Optional: defaults to https://notion.santimh.dev when unset.
NEXT_PUBLIC_SITE_URL=
